{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    },
    "project": null
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:jsx-a11y/recommended",
    "prettier"
  ],
  "plugins": ["@typescript-eslint", "react", "react-hooks", "jsx-a11y"],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "env": {
    "browser": true,
    "es2020": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "MemberExpression[object.name='toaster'][property.name='toast']",
        "message": "Show toasts through showToast() in src/services/show-toast.ts, which holds every field to the toast length budget."
      }
    ]
  },
  "ignorePatterns": ["dist/", "node_modules/", "*.generated.ts"],
  "overrides": [
    {
      "files": [
        "src/services/show-toast.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/test-support/**"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ]
}
